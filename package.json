{
  "name": "linear-sdk-cli",
  "version": "0.1.0",
  "description": "Ergonomic command-line interface for Linear, built on @linear/sdk",
  "type": "module",
  "license": "MIT",
  "author": "",
  "keywords": [
    "linear",
    "cli",
    "linear-app",
    "issue-tracker",
    "graphql"
  ],
  "bin": {
    "linear": "./dist/bin/linear.js",
    "lin": "./dist/bin/linear.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/bin/linear.ts",
    "lin": "tsx src/bin/linear.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run test/unit test/contract",
    "test:unit": "vitest run test/unit",
    "test:contract": "vitest run test/contract",
    "test:live": "pnpm build && vitest run test/integration",
    "test:live:admin": "pnpm build && LINEAR_CLI_LIVE_ADMIN=1 vitest run test/integration",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "audit:coverage": "tsx scripts/coverage-audit.ts",
    "janitor": "tsx test/janitor.ts"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.2.1",
    "@linear/sdk": "^87.0.0",
    "commander": "^13.0.0",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.3.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.9.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.2"
  }
}
