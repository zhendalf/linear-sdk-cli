{
  "name": "linear-sdk-cli",
  "version": "0.1.1",
  "description": "Ergonomic command-line interface for Linear, built on @linear/sdk",
  "type": "module",
  "license": "MIT",
  "author": "Eugene Beloded <belodedevgenij@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhendalf/linear-sdk-cli"
  },
  "homepage": "https://github.com/zhendalf/linear-sdk-cli#readme",
  "bugs": {
    "url": "https://github.com/zhendalf/linear-sdk-cli/issues"
  },
  "keywords": [
    "linear",
    "cli",
    "linear-app",
    "issue-tracker",
    "graphql"
  ],
  "bin": {
    "linear": "./src/bin/linear.ts",
    "lin": "./src/bin/linear.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    ".claude-plugin",
    "CHANGELOG.md",
    "COVERAGE.md",
    "LICENSE",
    "MIGRATING.md",
    "README.md",
    "skills",
    "src"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "prepublishOnly": "bun run verify",
    "dev": "bun run src/bin/linear.ts",
    "lin": "bun run src/bin/linear.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "bun test test/unit test/contract",
    "test:unit": "bun test test/unit",
    "test:contract": "bun test test/contract",
    "test:live": "LINEAR_CLI_LIVE=1 bun test --timeout 60000 test/integration",
    "test:live:admin": "LINEAR_CLI_LIVE=1 LINEAR_CLI_LIVE_ADMIN=1 bun test --timeout 60000 test/integration",
    "verify": "bun run typecheck && bun run lint && bun run test",
    "skill:docs": "bun run skills/linear-sdk-cli/scripts/generate-docs.ts",
    "audit:coverage": "bun run scripts/coverage-audit.ts",
    "janitor": "bun run test/janitor.ts"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.6.0",
    "@linear/sdk": "^91.0.0",
    "commander": "^15.0.0",
    "graphql": "^17.0.2",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.8.0"
  },
  "packageManager": "bun@1.4.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
